# Throwaway Dockerfile - 0.2.17 W0 Bucket 3 (B3.1).
#
# Purpose: validate the runtime+package-install loop end to end before
# W1 authors the production Dockerfile. NOT pushed to any registry.
# Build: podman build -f containers/Dockerfile.hello -t aho:hello .
# Run:   podman run --rm aho:hello aho --version
# Discard: podman rmi aho:hello once W0 acceptance archive references it.
#
# This file is intentionally minimal. W1's production Dockerfile is a
# separate artifact with multi-stage build, layer discipline, ollama
# binary, secrets-mount entrypoint, and the k8s-readiness five
# (configuration/secrets/logs/SIGTERM/health endpoints per ADR 0007
# §k8s-readiness amendment).

FROM debian:stable-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/aho

COPY pyproject.toml /opt/aho/pyproject.toml
COPY src /opt/aho/src

RUN python3 -m venv /opt/aho/.venv \
    && /opt/aho/.venv/bin/pip install /opt/aho

ENV PATH="/opt/aho/.venv/bin:${PATH}"

# No ENTRYPOINT - keeps the literal probe form
# `podman run --rm aho:hello aho --version` working as plan text expects.
# W1's production Dockerfile is the right place to introduce an entrypoint
# script (secrets mount + tier manifest read + OTEL setup); B3 throwaway
# stays minimal.
CMD ["aho", "--version"]
