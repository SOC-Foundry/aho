Screenshot_*.png
Screenshot-*.png
screenshot_*.png

# ─────────────────────────────────────────────────────────────────────────
# Deployment-private content - never track in a public-facing repo
# ─────────────────────────────────────────────────────────────────────────
#
# These categories contain operator/host/customer/internal context (specific
# hostnames, Tailscale IPs, lane paths, hardware fingerprints, customer
# codenames, internal canonical artifacts). They are per-deployment or
# chat-side staging artifacts, not part of the public product surface.
#
# To stop tracking files that are already in the index, run:
#   git rm --cached <path>
# then commit. .gitignore alone does not remove already-tracked files.

# Per-deployment Claude Code drafter/executor operating instructions
# (host fleet table, lane paths, operator identity, customer engagement notes)
/CLAUDE.md
/CLAUDE.md.*-archive
/CLAUDE.md.bak
/CLAUDE.md.bak.*

# Per-deployment GEMINI.md (external-audit-slot operating instructions)
/GEMINI.md

# Top-level loose iteration narrative files (drafter chat-side, project-internal)
/260*-*.md
/aho-run-*.md

# Tachtech-internal canonical artifacts - Chain of Trust, identity discipline,
# multi-vault setup, organizational architecture deep-dives
artifacts/tt-*.md
artifacts/tteos-*.md

# Pre-iteration drafter chat-side context (substrate facts, host fleet
# inventory, deployment-time arbitration notes)
artifacts/0.*-drafter-context.md
artifacts/*-drafter-context.md

# Observability + architecture deep-dives that may reference internal infra
# (Beacon overview, aho-quantum mockups, etc. - keep clean architectural
# docs in docs/architecture/ instead)
artifacts/observability/*-overview.md
artifacts/observability/mockup-*.html
artifacts/observability/aho-quantum-page-design.md

# One-time-cleanup scripts that explicitly name internal filenames
# (the script body lists deployment-private file paths; keep local-only)
/bin/aho-untrack-private.fish
/bin/aho-clean-commit-prep.fish
/bin/aho-finalize-push-prep.fish
/bin/aho-stage-sanitized.fish
/bin/aho-finalize-and-push.fish
/bin/aho-strip-em-dashes.fish
