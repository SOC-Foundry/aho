#!/usr/bin/env fish
# aho-rag-bootstrap — ingest canonical artifact set into per-project ChromaDB
# iteration-context collection. Closes F-0.3.1-W0-002 (W1 D2 of 0.3.1).
#
# Subcommands:
#   aho-rag-bootstrap                   Execute ingestion (default).
#   aho-rag-bootstrap --dry-run         Report planned shape without writing.
#   aho-rag-bootstrap --rebuild         Drop collection first, then ingest.
#   aho-rag-bootstrap --json            JSON output (machine-readable).
#   aho-rag-bootstrap --project <name>  Override default project (default: ahomw or $AHO_PROJECT).
#
# Per W1 amendment §D2. Pillar 4: wrappers are the tool surface.

set -g script_name "aho-rag-bootstrap"
set -g project_root (dirname (dirname (realpath (status filename))))

function _info
    set_color cyan; echo "[$script_name] $argv"; set_color normal
end

function _error
    set_color red; echo "[$script_name ERROR] $argv"; set_color normal
end

# Pre-flight: chromadb must be importable.
python3 -c 'import chromadb' 2>/dev/null
if test $status -ne 0
    _error "chromadb not importable in host Python. Run install.fish --step chromadb_importable to remediate."
    exit 1
end

# Delegate to python module. Prepend canonical src/ to PYTHONPATH so this runs
# against the canonical aho package even when a legacy editable install at a
# pre-migration path shadows it (F-0.3.1-W0-005 — W2 remediates the editable
# install; W1 works around in wrappers).
cd $project_root
set -x PYTHONPATH "$project_root/src" $PYTHONPATH
exec python3 -m aho.rag.bootstrap $argv
