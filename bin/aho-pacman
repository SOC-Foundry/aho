#!/usr/bin/env fish
# aho-pacman - Declarative native package manager wrapper.
# Reads from artifacts/harness/pacman-packages.txt.
# Subcommands: list, status, install, doctor

set -g script_name "aho-pacman"
set -g project_root (dirname (dirname (realpath (status filename))))
set -g pkg_file "$project_root/artifacts/harness/pacman-packages.txt"

function _info
    set_color cyan; echo "[$script_name] $argv"; set_color normal
end

function _warn
    set_color yellow; echo "[$script_name WARN] $argv"; set_color normal
end

function _error
    set_color red; echo "[$script_name ERROR] $argv"; set_color normal
end

function _gap
    set_color red; echo "[CAPABILITY GAP] $argv"; set_color normal
end

function _parse_packages
    if not test -f $pkg_file
        _error "Package list not found: $pkg_file"
        return 1
    end
    grep -v '^\s*#' $pkg_file | grep -v '^\s*$' | string trim; or true
end

function _cmd_list
    set -l pkgs (_parse_packages); or return 1
    for pkg in $pkgs
        echo $pkg
    end
end

function _pkg_present
    # Check pacman first, then fall back to command availability
    # (handles upstream-installed packages like ollama)
    if pacman -Qi $argv[1] >/dev/null 2>&1
        return 0
    end
    if command -q $argv[1]
        return 0
    end
    return 1
end

function _cmd_status
    set -l pkgs (_parse_packages); or return 1
    set -l installed 0
    set -l missing 0
    for pkg in $pkgs
        if _pkg_present $pkg
            set_color green; echo "  [installed] $pkg"; set_color normal
            set installed (math $installed + 1)
        else
            set_color red; echo "  [missing]   $pkg"; set_color normal
            set missing (math $missing + 1)
        end
    end
    _info "$installed installed, $missing missing out of "(count $pkgs)" declared packages"
end

function _cmd_install
    set -l pkgs (_parse_packages); or return 1
    if test (count $pkgs) -eq 0
        _info "No packages declared."
        return 0
    end
    _info "Installing "(count $pkgs)" packages via pacman --needed..."
    sudo pacman -S --needed $pkgs
    if test $status -ne 0
        _gap "pacman install failed. Check sudo access or network."
        return 1
    end
    _info "Package installation complete."
end

function _cmd_doctor
    set -l pkgs (_parse_packages); or return 1
    set -l missing
    for pkg in $pkgs
        if not _pkg_present $pkg
            set -a missing $pkg
        end
    end
    if test (count $missing) -gt 0
        _error "Missing packages: $missing"
        return 1
    end
    _info "All "(count $pkgs)" declared packages present."
    return 0
end

function _ignorepkg_present
    # Read-only check: is <pkg> in an active (uncommented) IgnorePkg line within
    # the [options] section of /etc/pacman.conf? No sudo required to read.
    set -l pkg $argv[1]
    python3 -c '
import sys, re
pkg = sys.argv[1]
section = None
try:
    with open("/etc/pacman.conf") as f:
        for line in f:
            s = line.strip()
            m = re.match(r"^\[(\w+)\]", s)
            if m:
                section = m.group(1)
                continue
            if section == "options" and s.startswith("IgnorePkg"):
                # right-hand side after =
                rhs = s.split("=", 1)[1] if "=" in s else ""
                names = re.split(r"[\s,]+", rhs.strip())
                if pkg in names:
                    sys.exit(0)
    sys.exit(1)
except OSError:
    sys.exit(2)
' $pkg
end

function _cmd_pin
    # pin <pkg> - ensure `IgnorePkg = <pkg>` is active in pacman.conf [options].
    # Idempotent: if already pinned, exits 0 with no write (and no sudo). If not
    # pinned, the edit requires sudo (a system-file modification) - surfaced to
    # the operator rather than performed silently.
    set -l pkg $argv[1]
    if test -z "$pkg"
        _error "usage: $script_name pin <package>"
        return 2
    end
    if _ignorepkg_present $pkg
        _info "IgnorePkg already includes '$pkg' in [options]. No change."
        return 0
    end
    _warn "IgnorePkg does not include '$pkg'. Editing /etc/pacman.conf needs sudo."
    _warn "Operator action: run the following to pin (system-file write):"
    echo "    sudo $script_name pin-apply $pkg"
    return 1
end

function _cmd_pin_apply
    # pin-apply <pkg> - the privileged half of pin. Must run under sudo. Inserts
    # <pkg> into the [options] IgnorePkg line (creating it if absent). Idempotent.
    set -l pkg $argv[1]
    if test -z "$pkg"
        _error "usage: sudo $script_name pin-apply <package>"
        return 2
    end
    if _ignorepkg_present $pkg
        _info "IgnorePkg already includes '$pkg'. No change."
        return 0
    end
    python3 -c '
import sys, re
pkg = sys.argv[1]
path = "/etc/pacman.conf"
with open(path) as f:
    lines = f.readlines()
out, section, inserted = [], None, False
for line in lines:
    s = line.rstrip("\n")
    m = re.match(r"^\[(\w+)\]", s.strip())
    if m:
        # leaving the [options] section without having inserted -> add a line
        if section == "options" and not inserted:
            out.append(f"IgnorePkg = {pkg}\n")
            inserted = True
        section = m.group(1)
        out.append(line)
        continue
    if section == "options" and s.strip().startswith("IgnorePkg") and not inserted:
        rhs = s.split("=", 1)[1].strip() if "=" in s else ""
        names = [n for n in re.split(r"[\s,]+", rhs) if n]
        if pkg not in names:
            names.append(pkg)
        out.append("IgnorePkg = " + " ".join(names) + "\n")
        inserted = True
        continue
    out.append(line)
if not inserted:
    # no [options] IgnorePkg line encountered; append at end (rare)
    out.append(f"\n[options]\nIgnorePkg = {pkg}\n")
with open(path, "w") as f:
    f.writelines(out)
print(f"pinned {pkg} in {path}")
' $pkg
end

# Subcommand dispatch
switch "$argv[1]"
    case list
        _cmd_list
    case status
        _cmd_status
    case install
        _cmd_install
    case doctor
        _cmd_doctor
    case pin
        _cmd_pin $argv[2]
    case pin-apply
        _cmd_pin_apply $argv[2]
    case '*'
        echo "Usage: $script_name {list|status|install|doctor|pin <pkg>|pin-apply <pkg>}"
        exit 1
end
