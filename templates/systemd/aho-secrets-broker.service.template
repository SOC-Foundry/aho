[Unit]
Description=aho host secrets broker (SO_PEERCRED unix-socket secrets accessor)
Documentation=https://github.com/SOC-Foundry/aho ADR-0009
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aho host secrets-broker --start
Restart=on-failure
RestartSec=3
# HOME so the broker can locate the aho secrets store. XDG_RUNTIME_DIR is
# provided by the user session; systemd --user inherits it.
Environment=HOME=%h

[Install]
WantedBy=default.target
